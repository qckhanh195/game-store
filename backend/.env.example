PORT=5000

# 1. Sử dụng database MongoDB Atlas (Cloud)
# Hãy thay đổi <username>, <password>, và <cluster-url> bằng thông tin kết nối MongoDB Atlas của bạn
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/game_store?appName=GameStore

# 2. Sử dụng database MongoDB chạy ở Local
# MONGO_URI=mongodb://localhost:27017/game_store
